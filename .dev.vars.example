# Copy to .dev.vars for local development:  cp .dev.vars.example .dev.vars
# .dev.vars is gitignored. Production values are set with `wrangler secret put`
# (secrets) or in wrangler.jsonc "vars" (non-secret configuration).

# ---- Required ---------------------------------------------------------------
# "development" enables dev-only conveniences (password-reset links are printed
# to the console instead of emailed). Production uses "production".
ENVIRONMENT=development
# Public origin of the app. Must match the URL in your browser.
BETTER_AUTH_URL=http://localhost:5173
# Random 32+ byte secret used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# ---- Optional ---------------------------------------------------------------
# Extra origins allowed to send authenticated requests (comma-separated).
# TRUSTED_ORIGINS=http://127.0.0.1:5173

# Email delivery (password reset + email reminders) via Resend.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=HackRadar <noreply@your-domain.com>

# "Continue with Google" — only shown when both are set.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Authorized provider feeds (HackRadar Feed v1, see docs/feed-format.md).
# Only configure these if you have explicit permission from the platform.
# A feed is used only when both FEED_URL and FEED_AUTHORIZATION_REF are set.
# DEVPOST_FEED_URL=
# DEVPOST_FEED_TOKEN=
# DEVPOST_FEED_AUTHORIZATION_REF=
# MACHINEHACK_FEED_URL=
# MACHINEHACK_FEED_TOKEN=
# MACHINEHACK_FEED_AUTHORIZATION_REF=
# MLH_FEED_URL=
# MLH_FEED_TOKEN=
# MLH_FEED_AUTHORIZATION_REF=
# UNSTOP_FEED_URL=
# UNSTOP_FEED_TOKEN=
# UNSTOP_FEED_AUTHORIZATION_REF=
