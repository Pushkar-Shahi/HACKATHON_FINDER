{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hackradar",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// The React SPA is served by Workers Static Assets. Every /api/* request is
	// routed to the Worker first; any other path that is not a file falls back
	// to index.html so client-side routes (e.g. /discover) never 404.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Production D1 database. Create it with:
	//   npx wrangler d1 create hackradar-db
	// then paste the returned database_id below. Local development does not need
	// a real ID — Wrangler/Miniflare keep a local SQLite copy in .wrangler/state.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hackradar-db",
			"database_id": "7305f3cd-8ab2-4e65-9665-cdef515999a3",
			"migrations_dir": "drizzle/migrations"
		}
	],
	// Cron Triggers run in UTC.
	//  - "15 */6 * * *": provider synchronization (only providers with an
	//    authorized feed configured are contacted; manual-mode providers are skipped)
	//  - "5 * * * *": hourly reminder scheduling + in-app/email delivery
	"triggers": {
		"crons": [
			"15 */6 * * *",
			"5 * * * *"
		]
	},
	// Non-secret configuration. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, ...)
	// are set with `wrangler secret put` and are never committed.
	"vars": {
		"ENVIRONMENT": "production",
		"BETTER_AUTH_URL": "https://hackradar.shahi-pushkar2008.workers.dev",
		"TRUSTED_ORIGINS": "",
		"EMAIL_FROM": ""
	},
	"env": {
		// Non-production environment with its own D1 database so preview deploys
		// never touch production data. Build with CLOUDFLARE_ENV=staging.
		"staging": {
			"name": "hackradar-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "hackradar-db-staging",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"triggers": {
				"crons": [
					"15 */6 * * *",
					"5 * * * *"
				]
			},
			"vars": {
				"ENVIRONMENT": "staging",
				"BETTER_AUTH_URL": "https://hackradar-staging.example.workers.dev",
				"TRUSTED_ORIGINS": "",
				"EMAIL_FROM": ""
			}
		}
	}
}