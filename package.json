{
	"name": "hackradar",
	"description": "HackRadar — centralized hackathon discovery and deadline tracking on Cloudflare Workers + D1",
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@tanstack/react-query": "^5.104.1",
		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.4.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"hono": "4.11.1",
		"lucide-react": "^1.55.0",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-router": "^8.4.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "5.1.1",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.11",
		"drizzle-kit": "^0.31.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "^30.1.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
		"check": "npm run build && wrangler deploy --dry-run",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
		"db:list:remote": "wrangler d1 migrations list DB --remote",
		"admin:grant": "node scripts/grant-admin.mjs",
		"cron:test": "node scripts/trigger-cron.mjs"
	},
	"type": "module",
	"version": "1.0.0",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	}
}
